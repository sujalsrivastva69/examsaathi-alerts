NODE_ENV=development
PORT=3000
TRUST_PROXY_HOPS=0
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
RESEND_API_KEY=your-server-only-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_WEBHOOK_SECRET=
NOTIFICATION_DRY_RUN=true
NOTIFICATION_CRON=*/5 * * * *
# Enable only after migration 202610150008 is applied to this database.
TRACKER_LIFECYCLE_ENABLED=false
# Enable only after migration 202610150009 is applied to this database.
PROFILE_MATCHING_FIELDS_ENABLED=false
# Local browsing only: reject API writes and do not start scheduled jobs.
LOCAL_VIEW_MODE=false
UNSUBSCRIBE_TOKEN_SECRET=
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
GOOGLE_CLOUD_VISION_API_KEY=
# Keep true unless a source's access permission is confirmed in sources.config.js.
INGESTION_DRY_RUN=true
INGESTION_CRON=0 */4 * * *
ADMIN_ALERT_EMAIL=
